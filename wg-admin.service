# wg-admin (deploy/vpn/wgadmin): WireGuard admin web UI + API on vpn1, 127.0.0.1:8080 behind nginx :8443 (LAN; the portal proxies /vpn/).
# Installed by setup-vpn1.sh. Runs unprivileged; root only through `sudo -n vpn-gate` (fixed requests).
[Unit]
Description=wg-admin (WireGuard admin UI)
After=network-online.target wg-quick@wg0.service
Wants=network-online.target

[Service]
User=wgadmin
Group=wgadmin
EnvironmentFile=/etc/wg-admin/wg-admin.env
WorkingDirectory=/opt/wg-admin
# Loopback only; nginx (wg-admin.nginx.conf) terminates TLS on :8443 and sends the client IP in X-Forwarded-For.
ExecStart=/usr/bin/python3 -m uvicorn --factory wgadmin.web:main_app --host 127.0.0.1 --port 8080 \
  --no-server-header --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
# No ProtectSystem/NoNewPrivileges: vpn-peer runs in this unit's namespace through sudo and writes /etc/wireguard.
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
